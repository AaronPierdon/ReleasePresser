<?xml version="1.0" encoding="utf-8"?>
<!--
  MAW's libraries come from nuget.org and nowhere else. <clear/> drops any other feed a machine might have
  (a stray local folder, an old company feed), and the source mapping means even a package name that exists
  elsewhere can only be fetched from nuget.org. NuGet checks nuget.org's signature on every package it restores.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
