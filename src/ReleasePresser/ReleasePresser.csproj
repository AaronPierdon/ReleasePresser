<Project Sdk="Microsoft.NET.Sdk">

  <!-- Release Presser: the stress-tested Pressing.Core engine, shared by MAW and MAWP.
       Apps reference this project from a sibling folder (..\ReleasePresser). Compile semantics are
       Pressing's own - Nullable + ImplicitUsings ENABLED - so the logic, fuzzy matching, lookup order
       and tool-use order stay exactly as tested. The namespace stays Pressing.Core. -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Pressing.Core</RootNamespace>
    <AssemblyName>ReleasePresser</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>1.0.0</Version>
    <!-- TagLibSharp targets netstandard2.0; NU1701 = restored against a non-net target (harmless, as in MAW.csproj) -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

</Project>
